# Dependencies — this library has none at runtime; sharp is a dev tool only.
node_modules/

# macOS
.DS_Store

# The staging area for images you have generated but not yet ingested.
# Raw drops are never published — `npm run ingest` produces the corpus files
# that are. Keep the folder (and its README) so the workflow is discoverable.
inbox/*
!inbox/README.md

# Snapshots of Health's real data, taken by Health/foodsum-dump.sh. Real meal
# logs for real accounts — they decide WHAT gets generated and are never
# published. Keep the folder (and its README) so the workflow is discoverable.
data/*
!data/README.md

# Local record of the last deploy.sh run — regenerated every deploy, not
# meaningful to any other machine.
.deploy-state.json
